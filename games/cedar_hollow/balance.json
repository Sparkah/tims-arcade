{
  "$schema": "./balance.schema.json",
  "_doc": "Cedar Hollow tuning data - the SINGLE SOURCE OF TRUTH for every economy/progression/combat number. Edited by Tim (by hand) or the balance agent (Phase 1). The game reads this at boot via the inline #balance-data block (kept in sync by tools/sync_balance.js); tools/sim.js reads this file directly. After editing, run: node tools/sync_balance.js && node tools/sim.js",

  "version": 1,

  "leveling": {
    "_doc": "Shared XP curve for all 7 skills. needXp(l) = round(BASE * GROWTH^(l-1)); a skill levels when cumulative XP crosses the next threshold.",
    "LEVEL_XP_BASE": 16,
    "LEVEL_XP_GROWTH": 1.22,
    "LEVEL_CAP": 50
  },

  "tools_global": {
    "_doc": "Tool effects applied to gathering. SPEED compounds per owned tier (action_time *= SPEED^tier); BONUS is per-tier double-yield chance.",
    "TOOL_SPEED": 0.85,
    "TOOL_BONUS": 0.08
  },

  "combat": {
    "_doc": "Hunt (Trail) combat constants. Player HP = HP_BASE + HP_PER_LVL*huntLvl. Auto-swing every SWING_SEC for ATK_BASE+ATK_PER_SPEAR*spearTier; manual STRIKE_DMG on tap (STRIKE_CD cooldown). EAT_CD gates healing; PACK_SIZE meals carried per hunt; KILL_GAP_SEC pause between animals in a chain.",
    "HP_BASE": 40,
    "HP_PER_LVL": 4,
    "ATK_BASE": 4,
    "ATK_PER_SPEAR": 4,
    "SWING_SEC": 1.2,
    "STRIKE_DMG": 5,
    "STRIKE_CD": 0.8,
    "EAT_CD": 2.0,
    "PACK_SIZE": 8,
    "KILL_GAP_SEC": 1.0
  },

  "offline": {
    "_doc": "Idle accrual while the tab/app is closed. Accrues the active job at OFFLINE_RATE of active speed, capped at OFFLINE_CAP_H hours (raised by the packmule upgrade), only if away >= OFFLINE_MIN_S.",
    "OFFLINE_RATE": 0.6,
    "OFFLINE_CAP_H": 8,
    "OFFLINE_MIN_S": 60
  },

  "cooking": {
    "_doc": "Seconds per cook action (cook XP/heal/buff live in meals[]).",
    "COOK_SEC": 1.6
  },

