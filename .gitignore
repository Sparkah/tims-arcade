# Yandex submission art is build material, not site content. For every other
# game it lives in Games/<N>_<slug>/yandex_promo/, outside this repo entirely.
# bloodtread_mobile is the one game whose source sits inside Gallery/, so keep
# its promo art untracked too — committing it marks the game "changed" and
# drags a Telegram-only title through the stage-1 Yandex submission gate.
games/*/yandex_promo/
games/*/art_provenance.json
