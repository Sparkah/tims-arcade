#!/usr/bin/env bash
# Pre-push: multi-stage gate before Cloudflare Pages auto-deploy.
#   Stage 0:   cover-art gate           (Gallery/scripts/check_art.sh)
#   Stage 0.5: webp-sibling gate        (inline below)
#   Stage 0.6: security P0 regressions  (Gallery/scripts/check_security_p0.js)
#   Stage 0.65: public discovery parity (Gallery/scripts/tests/test_discovery_surfaces.mjs)
#               temp cleanup on TERM    (Gallery/scripts/tests/test_pre_push_temp_cleanup.sh)
#   Stage 0.7: play-button visibility   (Gallery/scripts/check_play_visible.js)
#   Stage 0.75: dissertation mobile fit (Gallery/scripts/check_dissertation_mobile.js)
#   Stage 0.85: manifest dupe guard      (Gallery/scripts/check_manifest_dupes.sh)
#   Stage 0.86: meaningful update dates  (Gallery/scripts/check_updated_dates.py)
#   Stage 0.9: Yandex golden regressions (template/presubmit changes only)
#   Stage 1:   mechanical Yandex check  (blocking for changed games; full-gallery report-only)
#   Stage 2:   6-axis AI scorecard      (Gallery/scripts/pre_push_review.sh)
# Bypass entirely: `git push --no-verify`.
# Tune stage 2: REVIEW_THRESHOLD=4.5 git push   (default 5.0 — strict)
set -uo pipefail

ZERO_OID="0000000000000000000000000000000000000000"
GALLERY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
GIT_COMMON_DIR="$(git -C "$GALLERY_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [[ -n "$GIT_COMMON_DIR" ]]; then
  CANONICAL_GALLERY_ROOT="$(cd "$GIT_COMMON_DIR/.." 2>/dev/null && pwd)"
else
  CANONICAL_GALLERY_ROOT="$GALLERY_ROOT"
fi
AGENTS_ROOT="${AGENTS_ROOT:-$(cd "$CANONICAL_GALLERY_ROOT/.." 2>/dev/null && pwd)}"
# Git exports repository-local variables (notably GIT_DIR and GIT_INDEX_FILE)
# to hooks. Nested test repositories must not inherit them: on 2026-07-30 the
# updatedDate/IndexNow fixture commits otherwise targeted Gallery's real branch
# and index instead of their temporary directories. Resolve our paths first,
# then clear only Git's documented local variables and pin the hook cwd.
while IFS= read -r _git_local_var; do
  [[ -n "$_git_local_var" ]] && unset "$_git_local_var"
done < <(git -C "$GALLERY_ROOT" rev-parse --local-env-vars 2>/dev/null)
cd "$GALLERY_ROOT" || {
  echo "pre-push: cannot enter Gallery worktree $GALLERY_ROOT" >&2
  exit 1
}
REMOTE_NAME="${1:-origin}"
PUSH_REFS=()
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "${local_ref:-}" ]] || continue
  PUSH_REFS+=("$local_ref $local_oid $remote_ref $remote_oid")
done
if (( ${#PUSH_REFS[@]} > 0 )); then
  _has_branch_ref=0
  for _push_line in "${PUSH_REFS[@]}"; do
    IFS=' ' read -r _local_ref _local_oid _remote_ref _remote_oid <<< "$_push_line"
    [[ "$_remote_ref" == refs/heads/* ]] && _has_branch_ref=1
  done
  if (( _has_branch_ref == 0 )); then
    echo "pre-push: tag-only push has no Pages deployment tree; release gates skipped." >&2
    exit 0
  fi
fi
HOOK_TMP_BASE="${TMPDIR:-/tmp}"
case "$HOOK_TMP_BASE" in
  /*) ;;
  *)
    echo "pre-push: TMPDIR must be absolute." >&2
    exit 1
    ;;
esac
HOOK_TMP_ROOT="$HOOK_TMP_BASE/gallery-prepush.$$.$RANDOM$RANDOM"
HOOK_TMP_OWNED=0
cleanup_hook_tmp_root() {
  case "$HOOK_TMP_ROOT" in
    "$HOOK_TMP_BASE"/gallery-prepush.*)
      (( HOOK_TMP_OWNED == 1 )) && [[ -d "$HOOK_TMP_ROOT" ]] \
        && rm -rf -- "$HOOK_TMP_ROOT"
      ;;
  esac
}
trap cleanup_hook_tmp_root EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if ! (umask 077 && mkdir "$HOOK_TMP_ROOT"); then
  echo "pre-push: could not create owned temp root." >&2
  exit 1
fi
HOOK_TMP_OWNED=1
PYTHON_CACHE_ROOT="$HOOK_TMP_ROOT/pycache"
if ! mkdir -m 700 "$PYTHON_CACHE_ROOT"; then
  echo "pre-push: could not create isolated Python cache." >&2
  exit 1
fi
export PYTHONPYCACHEPREFIX="$PYTHON_CACHE_ROOT"

# Failure-only test seam: prove TERM still reaches the parent EXIT cleanup
# after a temp tree contains the same classes of files as a Yandex extraction.
if [[ "${GALLERY_PREPUSH_TEST_INTERRUPT_AFTER_TEMP:-0}" == "1" ]]; then
  mkdir -p "$HOOK_TMP_ROOT/yandex-interrupt-probe/yandex_promo"
  : > "$HOOK_TMP_ROOT/yandex-interrupt-probe/YANDEX_REJECTIONS.live.json"
  : > "$HOOK_TMP_ROOT/yandex-interrupt-probe/yandex_promo/cover_800x470.png"
  kill -TERM "$$"
  exit 143
fi

is_zero_oid() {
  [[ -z "${1:-}" || "$1" == "$ZERO_OID" ]]
}

remote_ref_base() {
  local local_oid="$1" remote_ref="$2" branch ref base
  branch="${remote_ref#refs/heads/}"
  for ref in "refs/remotes/$REMOTE_NAME/$branch" \
             "refs/remotes/$REMOTE_NAME/main" \
             "refs/remotes/$REMOTE_NAME/master" \
             "refs/remotes/origin/main" \
             "refs/remotes/origin/master"; do
    if git -C "$GALLERY_ROOT" show-ref --verify --quiet "$ref"; then
      base="$(git -C "$GALLERY_ROOT" merge-base "$local_oid" "$ref" 2>/dev/null || true)"
      if [[ -n "$base" ]]; then
        printf '%s\n' "$base"
        return 0
      fi
    fi
  done
  return 1
}

changed_files_for_ref() {
  local local_oid="$1" remote_ref="$2" remote_oid="$3" base
  is_zero_oid "$local_oid" && return 0
  if ! is_zero_oid "$remote_oid"; then
    if ! git -C "$GALLERY_ROOT" diff --name-only "$remote_oid" "$local_oid"; then
      echo "pre-push: could not enumerate changed files for ${local_oid:0:12} against remote ${remote_oid:0:12} ($remote_ref)." >&2
      return 2
    fi
    return 0
  fi

  base="$(remote_ref_base "$local_oid" "$remote_ref" 2>/dev/null || true)"
  if [[ -n "$base" ]]; then
    if ! git -C "$GALLERY_ROOT" diff --name-only "$base" "$local_oid"; then
      echo "pre-push: could not enumerate changed files for ${local_oid:0:12} against base ${base:0:12} ($remote_ref)." >&2
      return 2
    fi
  else
    if ! git -C "$GALLERY_ROOT" ls-tree -r --name-only "$local_oid"; then
      echo "pre-push: could not enumerate tree files for new ref ${local_oid:0:12} ($remote_ref)." >&2
      return 2
    fi
  fi
}

pushed_changed_files() {
  local line local_ref local_oid remote_ref remote_oid tmp status
  if (( ${#PUSH_REFS[@]} == 0 )); then
    return 0
  fi
  tmp="$(mktemp "$HOOK_TMP_ROOT/files.XXXXXX")" || return 2
  status=0
  for line in "${PUSH_REFS[@]}"; do
    IFS=' ' read -r local_ref local_oid remote_ref remote_oid <<< "$line"
    if ! changed_files_for_ref "$local_oid" "$remote_ref" "$remote_oid" >> "$tmp"; then
      status=2
    fi
  done
  if (( status != 0 )); then
    rm -f "$tmp"
    return "$status"
  fi
  sort -u "$tmp"
  rm -f "$tmp"
}

pushed_path_changed() {
  local wanted="$1" files rc f
  files="$(pushed_changed_files)"
  rc=$?
  if (( rc != 0 )); then
    return "$rc"
  fi
  while IFS= read -r f; do
    [[ "$f" == "$wanted" ]] && return 0
  done <<< "$files"
  return 1
}

pushed_prefix_changed() {
  local wanted="$1" files rc f
  files="$(pushed_changed_files)"
  rc=$?
  if (( rc != 0 )); then
    return "$rc"
  fi
  while IFS= read -r f; do
    [[ "$f" == "$wanted"* ]] && return 0
  done <<< "$files"
  return 1
}

is_release_gate_input() {
  local f="$1"
  # Local editor, dependency and report artefacts are neither imported by the
  # release helpers nor served from the committed Pages tree.
  case "$f" in
    .wrangler/*|*/.DS_Store|.DS_Store|*~|*.swp|*.swo|\
    node_modules/*|*/node_modules/*|coverage/*|*/coverage/*|\
    .idea/*|*/.idea/*|.vscode/*|*/.vscode/*|\
    .pytest_cache/*|*/.pytest_cache/*|.mypy_cache/*|*/.mypy_cache/*|\
    .ruff_cache/*|*/.ruff_cache/*|.venv/*|*/.venv/*|\
    venv/*|*/venv/*|scripts/__pycache__/*|scripts/tests/__pycache__/*|*.pyc)
      return 1
      ;;
    # Store-listing assets are deliberately checked by check_art.sh but are
    # not Pages inputs. They are allowed to remain outside the Gallery commit.
    games/*/yandex_promo/*)
      return 1
      ;;
    # These trees are imported, globbed or opened by a blocking release gate.
    functions/*|scripts/*|games/*|thumbs/*|previews/*|migrations/*|\
    dissertation/*|fonts/*)
      return 0
      ;;
  esac
  # Blocking helpers also read root web/config/discovery files. Restrict this
  # extension allowlist to root paths so unrelated ignored report directories
  # cannot block a push merely because they contain HTML/JS output.
  if [[ "$f" != */* ]]; then
    case "$f" in
      *.html|*.js|*.mjs|*.cjs|*.css|*.json|*.xml|*.txt|*.toml|\
      *.png|*.webp|*.svg|*.ico|_headers|_redirects)
        return 0
        ;;
    esac
  fi
  return 1
}

collect_untracked_gate_inputs() {
  local output="$1" raw="$HOOK_TMP_ROOT/untracked.raw" f
  : > "$output" || return 2
  if ! git -C "$GALLERY_ROOT" ls-files -z --others --exclude-standard > "$raw"; then
    return 2
  fi
  if ! git -C "$GALLERY_ROOT" ls-files -z --others --ignored --exclude-standard >> "$raw"; then
    return 2
  fi
  while IFS= read -r -d '' f; do
    [[ -n "$f" ]] || continue
    is_release_gate_input "$f" || continue
    printf '%s\0' "$f" >> "$output" || return 2
  done < "$raw"
}

helper_target_oid() {
  local line local_ref local_oid remote_ref remote_oid oid tree
  local -a deploy_oids=() branch_oids=() candidates=()
  for line in "${PUSH_REFS[@]}"; do
    IFS=' ' read -r local_ref local_oid remote_ref remote_oid <<< "$line"
    is_zero_oid "$local_oid" && continue
    case "$remote_ref" in
      refs/heads/main|refs/heads/master)
        deploy_oids+=("$local_oid")
        ;;
      refs/heads/*)
        branch_oids+=("$local_oid")
        ;;
    esac
  done
  if (( ${#deploy_oids[@]} > 0 )); then
    candidates=("${deploy_oids[@]}")
  else
    candidates=("${branch_oids[@]}")
  fi
  if (( ${#candidates[@]} == 0 )); then
    echo "pre-push: no non-deletion branch target requires release helpers." >&2
    return 2
  fi
  oid="${candidates[0]}"
  tree="$(git -C "$GALLERY_ROOT" rev-parse "$oid^{tree}" 2>/dev/null)" || return 2
  for local_oid in "${candidates[@]:1}"; do
    if [[ "$(git -C "$GALLERY_ROOT" rev-parse "$local_oid^{tree}" 2>/dev/null)" != "$tree" ]]; then
      echo "pre-push: pushed deployment refs contain distinct Gallery trees; split this push." >&2
      return 2
    fi
  done
  printf '%s\n' "$oid"
}

hook_helper_path() {
  local rel="$1" local_oid
  # Helper-driven gates import sibling modules and read manifest/assets from the
  # invoking worktree. Require its tracked tree to match the pushed object; the
  # pre-stage untracked-input gate separately rejects every untracked/ignored
  # file that could affect Pages code or rendering. Tags and non-deploy branches
  # alongside main do not affect the production tree; multiple relevant branch
  # refs are accepted only when their Gallery trees are byte-identical.
  local_oid="$(helper_target_oid)" || return 2
  if is_zero_oid "$local_oid" || [[ ! -f "$GALLERY_ROOT/$rel" ]]; then
    echo "pre-push: pushed helper is unavailable: $rel" >&2
    return 2
  fi
  if ! git -C "$GALLERY_ROOT" diff --quiet "$local_oid" --; then
    echo "pre-push: worktree differs from pushed object ${local_oid:0:12}; refusing inexact helper execution." >&2
    return 2
  fi
  printf '%s/%s\n' "$GALLERY_ROOT" "$rel"
}

changed_game_pairs() {
  local line local_ref local_oid remote_ref remote_oid tmp status
  if (( ${#PUSH_REFS[@]} == 0 )); then
    return 0
  fi
  tmp="$(mktemp "$HOOK_TMP_ROOT/games.XXXXXX")" || return 2
  status=0
  for line in "${PUSH_REFS[@]}"; do
    IFS=' ' read -r local_ref local_oid remote_ref remote_oid <<< "$line"
    if ! changed_files_for_ref "$local_oid" "$remote_ref" "$remote_oid" \
        | awk -v oid="$local_oid" -F/ '$1 == "games" && $2 != "" { print oid "\tgames/" $2 }' >> "$tmp"; then
      status=2
    fi
  done
  if (( status != 0 )); then
    rm -f "$tmp"
    return "$status"
  fi
  sort -u "$tmp"
  rm -f "$tmp"
}

manifest_publish_pairs_for_ref() {
  local local_oid="$1" remote_oid="$2" remote_ref="$3" base old_manifest new_manifest rc
  is_zero_oid "$local_oid" && return 0
  if ! is_zero_oid "$remote_oid"; then
    base="$remote_oid"
  else
    base="$(remote_ref_base "$local_oid" "$remote_ref" 2>/dev/null || true)"
  fi
  [[ -n "$base" ]] || return 0
  old_manifest="$(mktemp "$HOOK_TMP_ROOT/old-manifest.XXXXXX")" || return 2
  new_manifest="$(mktemp "$HOOK_TMP_ROOT/new-manifest.XXXXXX")" || {
    rm -f "$old_manifest"
    return 2
  }
  git -C "$GALLERY_ROOT" show "$base:games.json" > "$old_manifest" 2>/dev/null || :
  if ! git -C "$GALLERY_ROOT" show "$local_oid:games.json" > "$new_manifest" 2>/dev/null; then
    rm -f "$old_manifest" "$new_manifest"
    return 0
  fi
  python3 -c 'import json, sys
oid, old_path, new_path = sys.argv[1:4]
try:
    old = json.load(open(old_path)) if old_path else []
    new = json.load(open(new_path)) if new_path else []
except Exception:
    sys.exit(2)
old_pub = {
    item.get("slug"): item.get("published") is not False and item.get("external") is not True
    for item in old
    if isinstance(item, dict) and item.get("slug")
}
for item in new if isinstance(new, list) else []:
    if not isinstance(item, dict):
        continue
    slug = item.get("slug")
    # External cards are platform link-outs and deliberately have no games/<slug>
    # payload. An external -> local transition still enters the gate via old_pub.
    if not slug or item.get("published") is False or item.get("external") is True:
        continue
    if old_pub.get(slug) is not True:
        print(f"{oid}\tgames/{slug}")
' "$local_oid" "$old_manifest" "$new_manifest"
  rc=$?
  rm -f "$old_manifest" "$new_manifest"
  return "$rc"
}

manifest_publish_pairs() {
  local line local_ref local_oid remote_ref remote_oid tmp status
  if (( ${#PUSH_REFS[@]} == 0 )); then
    return 0
  fi
  tmp="$(mktemp "$HOOK_TMP_ROOT/publish.XXXXXX")" || return 2
  status=0
  for line in "${PUSH_REFS[@]}"; do
    IFS=' ' read -r local_ref local_oid remote_ref remote_oid <<< "$line"
    if ! manifest_publish_pairs_for_ref "$local_oid" "$remote_oid" "$remote_ref" >> "$tmp"; then
      status=2
    fi
  done
  if (( status != 0 )); then
    rm -f "$tmp"
    return "$status"
  fi
  sort -u "$tmp"
  rm -f "$tmp"
}

stage1_game_pairs() {
  local tmp rc
  tmp="$(mktemp "$HOOK_TMP_ROOT/stage1.XXXXXX")" || return 2
  if ! changed_game_pairs >> "$tmp"; then
    rm -f "$tmp"
    return 2
  fi
  if ! manifest_publish_pairs >> "$tmp"; then
    rm -f "$tmp"
    return 2
  fi
  sort -u "$tmp"
  rc=$?
  rm -f "$tmp"
  return "$rc"
}

game_tree_exists_at_oid() {
  local oid="$1" rel="$2"
  git -C "$GALLERY_ROOT" cat-file -e "$oid:$rel" 2>/dev/null
}

game_index_exists_at_oid() {
  local oid="$1" rel="$2"
  git -C "$GALLERY_ROOT" cat-file -e "$oid:$rel/index.html" 2>/dev/null
}

game_slug_from_rel() {
  local rel="$1" rest
  rest="${rel#games/}"
  printf '%s\n' "${rest%%/*}"
}

safe_relative_path() {
  local path="$1"
  [[ -n "$path" ]] || return 1
  case "$path" in
    /*|..|../*|*/..|*/../*) return 1 ;;
  esac
  return 0
}

source_game_dir_at_oid() {
  local oid="$1" rel="$2" slug source_rel
  slug="$(game_slug_from_rel "$rel")"
  source_rel="$(git -C "$GALLERY_ROOT" show "$oid:games.source.json" 2>/dev/null \
    | python3 -c 'import json, sys
slug = sys.argv[1]
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for item in data if isinstance(data, list) else []:
    if item.get("slug") == slug:
        print(item.get("gameDir") or "")
        break
' "$slug" 2>/dev/null || true)"
  if safe_relative_path "$source_rel"; then
    printf '%s\n' "$source_rel"
  else
    printf 'Gallery/%s\n' "$rel"
  fi
}

game_manifest_status_at_oid() {
  local oid="$1" rel="$2" slug status
  slug="$(game_slug_from_rel "$rel")"
  status="$(git -C "$GALLERY_ROOT" show "$oid:games.json" 2>/dev/null \
    | python3 -c 'import json, sys
slug = sys.argv[1]
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(2)
for item in data if isinstance(data, list) else []:
    if item.get("slug") == slug:
        print("unpublished" if item.get("published") is False else "published")
        sys.exit(0)
print("absent")
' "$slug" 2>/dev/null)"
  case "$status" in
    published|unpublished|absent)
      printf '%s\n' "$status"
      return 0
      ;;
    *)
      return 2
      ;;
  esac
}

extract_game_tree_for_oid() {
  local oid="$1" rel="$2" tmp_root tmp_extract status_rel dir
  if ! game_tree_exists_at_oid "$oid" "$rel"; then
    return 2
  fi
  if ! game_index_exists_at_oid "$oid" "$rel"; then
    echo "stage-1 Yandex: $rel exists in pushed commit ${oid:0:12} but has no index.html." >&2
    echo "   A published game without index.html is a HARD presubmit failure; restore it or remove/unpublish the game deliberately." >&2
    return 1
  fi

  tmp_root="$(mktemp -d "$HOOK_TMP_ROOT/yandex.XXXXXX")" || return 1
  tmp_extract="$tmp_root/_archive"
  status_rel="$(source_game_dir_at_oid "$oid" "$rel")"
  if ! safe_relative_path "$status_rel"; then
    rm -rf "$tmp_root"
    echo "stage-1 Yandex: unsafe status path '$status_rel' for $rel; failing closed." >&2
    return 1
  fi
  dir="$tmp_root/$status_rel"
  if ! mkdir -p "$tmp_extract" "$(dirname "$dir")"; then
    rm -rf "$tmp_root"
    echo "stage-1 Yandex: could not create temp checkout for $rel." >&2
    return 1
  fi

  if ! git -C "$GALLERY_ROOT" archive "$oid" "$rel" | tar -x -C "$tmp_extract"; then
    rm -rf "$tmp_root"
    echo "stage-1 Yandex: could not materialize $rel from pushed commit ${oid:0:12}; failing closed." >&2
    return 1
  fi
  if [[ ! -d "$tmp_extract/$rel" ]]; then
    rm -rf "$tmp_root"
    echo "stage-1 Yandex: extracted $rel from ${oid:0:12}, but the game directory is missing; failing closed." >&2
    return 1
  fi
  if ! mv "$tmp_extract/$rel" "$dir"; then
    rm -rf "$tmp_root"
    echo "stage-1 Yandex: could not move $rel into status path $status_rel; failing closed." >&2
    return 1
  fi
  rm -rf "$tmp_extract"

  # The tree above is the PUBLISHED payload wearing the source dir's name (so
  # status.json resolves). Some presubmit inputs exist ONLY in the source dir and
  # must never reach the CDN: YANDEX_REJECTIONS.live.json is live moderation
  # state pulled from the console, and yandex_promo/ is the store listing.
  # Without them the live-rejection check reports the artifact "missing" for
  # every game holding an appId - 36 of them - so a gallery push for any of those
  # was unsatisfiable except by publishing console data. Copied in for the check
  # only; this temp tree is deleted afterwards and nothing here is published.
  local src_dir="$AGENTS_ROOT/$status_rel" extra
  if [[ -d "$src_dir" ]]; then
    for extra in YANDEX_REJECTIONS.live.json YANDEX_REJECTIONS.md; do
      [[ -f "$src_dir/$extra" && ! -f "$dir/$extra" ]] && cp "$src_dir/$extra" "$dir/$extra" 2>/dev/null
    done
    [[ -d "$src_dir/yandex_promo" && ! -d "$dir/yandex_promo" ]] \
      && cp -R "$src_dir/yandex_promo" "$dir/yandex_promo" 2>/dev/null
  fi

  printf '%s\t%s\n' "$tmp_root" "$dir"
}

run_stage0_regression_if_needed() {
  local gate="$1" mode="${YANDEX_STAGE0_REGRESSION:-auto}" should_run=0 files rc f
  case "$mode" in
    force|1|true|yes)
      should_run=1
      ;;
    0|false|off|no)
      echo "stage0 regression gate: skipped (YANDEX_STAGE0_REGRESSION=$mode)." >&2
      return 0
      ;;
    auto|"")
      files="$(pushed_changed_files)"
      rc=$?
      if (( rc != 0 )); then
        echo "stage0 regression gate: could not enumerate pushed files; failing closed." >&2
        return "$rc"
      fi
      while IFS= read -r f; do
        case "$f" in
          scripts/hooks/pre-push|scripts/install_hooks.sh)
            should_run=1
            break
            ;;
        esac
      done <<< "$files"
      ;;
    *)
      echo "pre-push: unknown YANDEX_STAGE0_REGRESSION=$mode (expected auto, force, off)" >&2
      return 2
      ;;
  esac

  if (( should_run != 1 )); then
    echo "stage0 regression gate: no pushed Yandex gate/template changes detected; skipping." >&2
    return 0
  fi
  if [[ ! -x "$gate" ]]; then
    echo "stage0 regression gate: runner missing or not executable: $gate" >&2
    return 2
  fi
  "$gate" --force
}

run_yandex_gallery_report() {
  local checker="$1" mode="${YANDEX_STAGE1_REPORT:-summary}" out rc
  case "$mode" in
    0|false|off|no)
      echo "stage-1 Yandex: full-gallery sweep skipped (YANDEX_STAGE1_REPORT=$mode)." >&2
      return 0
      ;;
    full)
      echo "stage-1 Yandex: full-gallery sweep report-only (non-blocking)." >&2
      YANDEX_PRESUBMIT_GALLERY_DIR="$GALLERY_ROOT/games" \
      YANDEX_PRESUBMIT_GALLERY_MANIFEST="$GALLERY_ROOT/games.json" \
        "$checker" --gallery || echo "stage-1 Yandex: full-gallery HARD findings are report-only for this push." >&2
      return 0
      ;;
  esac

  if ! command -v jq >/dev/null 2>&1; then
    echo "stage-1 Yandex: jq missing; falling back to noisy full-gallery report-only scan." >&2
    YANDEX_PRESUBMIT_GALLERY_DIR="$GALLERY_ROOT/games" \
    YANDEX_PRESUBMIT_GALLERY_MANIFEST="$GALLERY_ROOT/games.json" \
      "$checker" --gallery || echo "stage-1 Yandex: full-gallery HARD findings are report-only for this push." >&2
    return 0
  fi

  out="$(YANDEX_PRESUBMIT_GALLERY_DIR="$GALLERY_ROOT/games" \
         YANDEX_PRESUBMIT_GALLERY_MANIFEST="$GALLERY_ROOT/games.json" \
         "$checker" --json --gallery 2>/dev/null)"
  rc=$?
  if [[ -z "$out" ]]; then
    echo "stage-1 Yandex: full-gallery report failed to produce JSON (rc=$rc); not blocking unrelated pushes." >&2
    return 0
  fi
  printf '%s' "$out" | jq -r '
    "stage-1 Yandex full-gallery report (non-blocking):",
    "  games scanned: \(.games | length)",
    "  hard-failing games: \([.games[] | select(.fails > 0)] | length)",
    "  warning-only games: \([.games[] | select(.fails == 0 and .warns > 0)] | length)",
    "  skipped games: \([.games[] | select(.status == "skipped")] | length)",
    (if ([.games[] | select(.fails > 0)] | length) > 0 then
      "  top hard failures:",
      ([.games[]
        | select(.fails > 0)
        | {game, fails, checks: ([.findings[] | select(.severity == "HARD") | .check] | unique | join(","))}
       ] | sort_by(-.fails) | .[:12][] | "    - \(.game): \(.checks)")
    else
      "  hard failures: none"
    end)
  ' >&2 || echo "stage-1 Yandex: could not summarize report JSON (rc=$rc); not blocking unrelated pushes." >&2
  return 0
}

run_yandex_stage1() {
  local checker="$1" scope="${YANDEX_STAGE1_SCOPE:-auto}" line oid rel dir tmp_root extracted rc manifest_status fail=0 game_pairs=() game_labels=()

  case "$scope" in
    full)
      YANDEX_PRESUBMIT_GALLERY_DIR="$GALLERY_ROOT/games" \
      YANDEX_PRESUBMIT_GALLERY_MANIFEST="$GALLERY_ROOT/games.json" \
        "$checker" --gallery
      return $?
      ;;
    report)
      run_yandex_gallery_report "$checker"
      return 0
      ;;
    auto|"")
      ;;
    *)
      echo "pre-push: unknown YANDEX_STAGE1_SCOPE=$scope (expected auto, report, full)" >&2
      return 2
      ;;
  esac

  extracted="$(stage1_game_pairs)"
  rc=$?
  if (( rc != 0 )); then
    echo "stage-1 Yandex: could not enumerate changed games; failing closed." >&2
    return "$rc"
  fi
  while IFS= read -r line; do
    [[ -n "$line" ]] && game_pairs+=("$line")
  done <<< "$extracted"

  if (( ${#game_pairs[@]} == 0 )); then
    echo "stage-1 Yandex: no pushed game files; skipping blocking per-game checks." >&2
    run_yandex_gallery_report "$checker"
    return 0
  fi

  for line in "${game_pairs[@]}"; do
    IFS=$'\t' read -r oid rel <<< "$line"
    game_labels+=("$rel@${oid:0:12}")
  done
  echo "stage-1 Yandex: blocking check for changed game(s): ${game_labels[*]}" >&2

  for line in "${game_pairs[@]}"; do
    IFS=$'\t' read -r oid rel <<< "$line"
    extracted="$(extract_game_tree_for_oid "$oid" "$rel")"
    rc=$?
    case "$rc" in
      0) ;;
      2)
        manifest_status="$(game_manifest_status_at_oid "$oid" "$rel")"
        rc=$?
        if (( rc != 0 )); then
          echo "stage-1 Yandex: $rel is deleted in ${oid:0:12}, but games.json could not be checked; failing closed." >&2
          fail=1
          continue
        fi
        case "$manifest_status" in
          absent|unpublished)
            echo "stage-1 Yandex: $rel is deleted and games.json marks it $manifest_status; skipping per-game check." >&2
            continue
            ;;
          *)
            echo "stage-1 Yandex: $rel is deleted in ${oid:0:12} but still published in games.json; failing closed." >&2
            fail=1
            continue
            ;;
        esac
        ;;
      *)
        fail=1
        continue
        ;;
    esac
    tmp_root="${extracted%%$'\t'*}"
    dir="${extracted#*$'\t'}"
    if ! YANDEX_PRESUBMIT_STATUS_ROOT="$tmp_root" \
         YANDEX_PRESUBMIT_STATUS_FILE="$AGENTS_ROOT/Shared/data/submissions/status.json" \
         "$checker" "$dir"; then
      fail=1
    fi
    rm -rf "$tmp_root"
  done

  if (( fail != 0 )); then
    echo "" >&2
    echo "🚫 Push aborted by stage-1 Yandex changed-game gate." >&2
    echo "   Fix the changed game(s), or use YANDEX_STAGE1_SCOPE=report only after explicit risk acceptance." >&2
    return 1
  fi

  run_yandex_gallery_report "$checker"
  return 0
}

UNTRACKED_GATE_INPUTS_FILE="$HOOK_TMP_ROOT/untracked-gate-inputs"
if ! collect_untracked_gate_inputs "$UNTRACKED_GATE_INPUTS_FILE"; then
  echo "pre-push: could not enumerate untracked gate inputs; failing closed." >&2
  exit 1
fi
if [[ -s "$UNTRACKED_GATE_INPUTS_FILE" ]]; then
  echo "pre-push: untracked or ignored files could influence release gates:" >&2
  while IFS= read -r -d '' _gate_file; do
    printf '  - %q\n' "$_gate_file" >&2
  done < "$UNTRACKED_GATE_INPUTS_FILE"
  echo "Commit, move, or remove those files before pushing." >&2
  exit 1
fi
# Failure-only test seam: a safe-input regression must prove it reached this
# point without continuing into the push lock or any expensive release gate.
if [[ "${GALLERY_PREPUSH_TEST_UNTRACKED_SAFE_MARKER:-0}" == "1" ]]; then
  echo "pre-push: untracked-input safe marker reached" >&2
  exit 86
fi

# Stage -1: Gallery push lock - serialise concurrent pushes (scripts + agents) so
# they stop racing on the working tree / the main ref (the 2026-05-30/31 collisions:
# one agent's commit swallowing another's files; two pushes fighting refs/heads/main).
# If the invoking script already holds the lock (GF_PUSH_LOCK_TOKEN == holder token)
# we proceed and let IT release; otherwise acquire for the gate + release on exit.
# If ANOTHER agent holds it, DEFER cleanly (abort - retry once they finish), no race.
PUSH_LOCK="$GALLERY_ROOT/scripts/push_lock.sh"
if [[ -x "$PUSH_LOCK" ]]; then
  _held="$(bash "$PUSH_LOCK" holder 2>/dev/null | sed -n 's/^token=//p')"
  if [[ -n "${GF_PUSH_LOCK_TOKEN:-}" && "$GF_PUSH_LOCK_TOKEN" == "$_held" ]]; then
    :  # the script that invoked this push holds the lock; it will release.
  else
    _hooktok="$(bash "$PUSH_LOCK" acquire "pre-push:$(whoami)" 2>/dev/null)" || {
      echo "" >&2
      echo "🔒 Gallery push DEFERRED - another agent holds the push lock:" >&2
      bash "$PUSH_LOCK" holder 2>/dev/null | sed 's/^/     /' >&2
      echo "   Retry shortly; the holder releases when its push finishes." >&2
      exit 1
    }
    trap 'bash "$PUSH_LOCK" release "$_hooktok" 2>/dev/null; cleanup_hook_tmp_root' EXIT
  fi
fi

if ! ART_CHECK="$(hook_helper_path scripts/check_art.sh)"; then
  echo "🚫 Push aborted: stage-0 helper could not be resolved from the exact pushed tree." >&2
  exit 1
fi
if [[ -x "$ART_CHECK" ]]; then
  if ! AGENTS_ROOT="$AGENTS_ROOT" GALLERY_ROOT="$GALLERY_ROOT" "$ART_CHECK" --quiet; then
    echo "" >&2
    echo "🚫 Push aborted by stage-0 cover-art gate." >&2
    echo "   Generate the missing covers OR re-push with --no-verify." >&2
    exit 1
  fi
else
  echo "pre-push: $ART_CHECK missing — skipping stage 0" >&2
fi

# Stage 0.5: every Gallery/thumbs/*.png MUST have a matching .webp sibling.
# <picture> picks WebP first; missing webp → CF serves SPA index.html with
# HTTP 200 → broken-image cards. (Third strike: 2026-05-13, 2026-05-15,
# 2026-05-19.)
THUMBS_DIR="$GALLERY_ROOT/thumbs"
if [[ -d "$THUMBS_DIR" ]]; then
  shopt -s nullglob
  missing=()
  for png in "$THUMBS_DIR"/*.png; do
    webp="${png%.png}.webp"
    [[ -f "$webp" ]] || missing+=("$(basename "$png")")
  done
  if (( ${#missing[@]} > 0 )); then
    echo "" >&2
    echo "🚫 Push aborted by stage-0.5 webp gate — ${#missing[@]} thumb(s) missing .webp:" >&2
    printf "   - %s\n" "${missing[@]}" >&2
    echo "   Fix: bash Gallery/scripts/build_webp_thumbs.sh" >&2
    exit 1
  fi
fi

