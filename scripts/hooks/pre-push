# Stage 0.86: public game/code/art/metadata changes must carry a genuine
# updatedDate. This keeps sitemap lastmod and page dateModified meaningful
# instead of stamping every URL with the sync wall clock.
UPDATED_DATE_GATE="$GALLERY_ROOT/scripts/check_updated_dates.py"
if [[ -f "$UPDATED_DATE_GATE" ]] && command -v python3 >/dev/null 2>&1; then
  for line in "${PUSH_REFS[@]}"; do
    IFS=' ' read -r local_ref local_oid remote_ref remote_oid <<< "$line"
    is_zero_oid "$local_oid" && continue
    if ! is_zero_oid "$remote_oid"; then
      _updated_base="$remote_oid"
    else
      _updated_base="$(remote_ref_base "$local_oid" "$remote_ref" 2>/dev/null || true)"
      [[ -n "$_updated_base" ]] || _updated_base="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
    fi
    if ! python3 "$UPDATED_DATE_GATE" --from "$_updated_base" --to "$local_oid"; then
      echo "🚫 Push aborted by stage-0.86 updatedDate gate." >&2
      exit 1
    fi
  done
else
  echo "pre-push: $UPDATED_DATE_GATE missing or python3 unavailable — skipping stage 0.86" >&2
fi

